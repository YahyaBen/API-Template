{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "IdentityEvents": {
    "Enabled": false,
    "Queue": "foodiya.profiles.identity",
    "MaxAttempts": 5,
    "RetryDelaySeconds": 5
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "CorsOrigins": [],
  "Authentication": {
    "Google": {
      "ClientIds": []
    },
    "Jwt": {
      "Authority": "https://identity.foodiya.app",
      "Issuer": "https://identity.foodiya.app",
      "Audience": "foodiya.app.Identity.Clients"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "KnownNetworks": [],
    "KnownProxies": [],
    "Enabled": false,
    "ForwardLimit": 1
  },
  "ApiLimits": {
    "PermitLimit": 120,
    "WindowSeconds": 60
  }
}
