{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "IdentityEvents": {
    "Enabled": false,
    "Queue": "foodiya.profiles.identity",
    "MaxAttempts": 5,
    "RetryDelaySeconds": 5
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "CorsOrigins": [
    "http://localhost:4200",
    "http://localhost:8081",
    "http://127.0.0.1:8081",
    "http://localhost:8082",
    "http://localhost:8082"
  ],
  "Authentication": {
    "Google": {
      "ClientIds": []
    },
    "Jwt": {
      "Authority": "https://identity.foodiya.app",
      "Issuer": "https://identity.foodiya.app",
      "Audience": "foodiya.app.Identity.Clients"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Information"
    }
  },
  "AllowedHosts": "*"
}
