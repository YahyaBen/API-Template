# Copy to .env and provide a connection to the Foodiya business database.
# For Docker, the server must be reachable from the container (not localhost).
DEFAULT_CONNECTION=Server=your-sql-host,1433;Database=Foodiya;User ID=your-user;Password=replace-me;Encrypt=True;TrustServerCertificate=False
IDENTITY_AUTHORITY=https://your-identity-host.example
IDENTITY_ISSUER=https://your-identity-host.example
IDENTITY_AUDIENCE=foodiya.app.Identity.Clients
