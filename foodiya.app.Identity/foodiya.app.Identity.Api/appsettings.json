{
  "ConnectionStrings": {
    "IdentityDatabase": "Server=(localdb)\\MSSQLLocalDB;Database=FOODIYA_APP_IDENTITY;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Registration": {
    "OtpLifetimeMinutes": 10,
    "OtpMaxAttempts": 5,
    "OtpResendCooldownSeconds": 60
  },
  "Tokens": {
    "Issuer": "https://identity.foodiya.app",
    "Audience": "foodiya.app.Identity.Clients",
    "KeyId": "foodiya-app-identity-v1",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 30
  },
  "Authentication": {
    "Google": {
      "ClientIds": []
    }
  },
  "BootstrapAdmin": {
    "Enabled": false
  },
  "AccountLifecycle": {
    "PasswordHistoryCount": 5
  },
  "Cleanup": {
    "Enabled": false,
    "IntervalMinutes": 60,
    "BatchSize": 500,
    "SessionRetentionDays": 30,
    "OtpRetentionDays": 7,
    "ProcessedEventRetentionDays": 30,
    "RegistrationAttemptRetentionDays": 30,
    "DeletedAccountRetentionDays": 90
  },
  "Outbox": {
    "Enabled": false,
    "Transport": "Webhook",
    "Endpoint": "",
    "SigningSecret": "",
    "IntervalSeconds": 5,
    "BatchSize": 50,
    "MaxAttempts": 10,
    "LeaseSeconds": 120,
    "TimeoutSeconds": 20
  },
  "EmailDelivery": {
    "Provider": "Disabled",
    "Host": "",
    "Port": 587,
    "FromAddress": "no-reply@foodiya.app",
    "UserName": "",
    "Password": "",
    "TimeoutSeconds": 40,
    "UseStartTls": true,
    "LogDevelopmentCodes": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
