# Generate real values with: pwsh ./scripts/New-LocalSecrets.ps1
SQL_SERVER_SA_PASSWORD=replace-with-a-strong-sql-server-password
IDENTITY_ISSUER=https://identity.example.com
Registration__OtpPepper=replace-with-at-least-32-random-characters
Tokens__RefreshTokenPepper=replace-with-an-independent-random-value
Tokens__KeyId=foodiya-app-identity-local-key
EmailDelivery__Provider=Smtp
EmailDelivery__Host=smtp.example.com
EmailDelivery__Port=587
EmailDelivery__FromAddress=no-reply@example.com
EmailDelivery__UserName=replace-with-smtp-user
EmailDelivery__Password=replace-with-smtp-password
EmailDelivery__UseStartTls=true
Outbox__SigningSecret=replace-with-an-independent-random-value
# RabbitMQ delivery: use docker-compose.rabbitmq.yml and ../deployment/rabbitmq/.env
# For a local dotnet process, set Outbox__Enabled=true, Outbox__Transport=RabbitMq,
# RabbitMq__HostName=localhost, and load the broker credentials into the environment.
BootstrapAdmin__Enabled=false
BootstrapAdmin__Email=admin@foodiya.app
BootstrapAdmin__UserName=foodiya-admin
BootstrapAdmin__Password=replace-with-a-strong-unique-password
BootstrapAdmin__FirstName=Foodiya
BootstrapAdmin__LastName=Administrator
